{
  "id": "./",
  "name": "Sudachi",
  "short_name": "Sudachi",
  "description": "Your media logger: books, comics & manga, games, anime, films and series. A shelf for what you're on, picks planned around your shifts, your own S–F tiers, and every month and year in review. The library of the citrus family.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "entertainment",
    "lifestyle",
    "books"
  ],
  "background_color": "#0b0a14",
  "theme_color": "#0b0a14",
  "shortcuts": [
    {
      "name": "Log something",
      "short_name": "Log",
      "url": "./index.html?do=log",
